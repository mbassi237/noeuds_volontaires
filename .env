VOLUNTEER_ID=0           
COORDINATOR_HOST=192.168.68.143 
MANAGER_HOST=192.168.68.143      

N_VOLUNTEERS=2
MY_IP=                            
DATASET=cifar10                     
DATA_PARTITION=iid            
COMPRESSION=quantization
MODEL_NAME=resnet18
K_NEIGHBORS=1
GOSSIP_INTERVAL=60           
GOSSIP_FANOUT=1
LOCAL_EPOCHS=1
MAX_ROUNDS=10
BATCH_SIZE=32
LEARNING_RATE=0.001
NUM_CLASSES=10
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=90
SOCKET_TIMEOUT=300
ADAPTIVE_LR_METHOD=adastair

CPU_CORES=4
RAM_GB=8
NETWORK_MBPS=100

# AD-PSGD
ADPSGD_ENABLED=true          # true | false
ADPSGD_TOPOLOGY=exponential  # exponential (O(log n)) | ring (O(n))
ADPSGD_ROLE=auto             # auto | active | passive
ADPSGD_ALPHA=0.5             # poids de la moyenne symétrique (0 < alpha < 1)